{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "icons/**"
    ],
    "rewrites": [
      {
        "source": "/api/catalog/collectionNodes.bundle",
        "function": "catalogCollectionNodesBundle"
      },
      {
        "source": "/api/catalog/items.bundle",
        "function": "catalogItemsBundle"
      },
      {
        "source": "/api/catalog/item-icon",
        "function": "catalogItemIconUpload"
      },
      {
        "source": "/api/database/item-import",
        "function": "databaseItemImport"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5000
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
